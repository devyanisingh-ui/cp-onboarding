{
  "name": "cp-onboarding-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "build:mobile": "tsc -b && vite build --mode mobile && node -e \"require('fs').copyFileSync('dist-mobile/index.html','cp-onboarding-mobile.html')\"",
    "build:share": "npm run build:mobile && node scripts/make-share.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "3.9",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.49.0",
    "pdf-lib": "^1.17.1",
    "react": "18.3",
    "react-dom": "18.3",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "6.28",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.23"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
