// Admin configuration: regions, institutions and their campuses, who belongs where, approval
// routing, settings (SLAs, master lists, allowed domains), and the versioned rate cards and
// agreement templates (maker-checker: Admin drafts, Legal approves, Admin publishes).

model Region {
  id           String        @id @db.VarChar(32)
  name         String        @db.VarChar(120)
  institutions Institution[]
}

enum InstitutionType {
  university
  college
  school
}

model Institution {
  id                   String            @id @db.VarChar(32)
  legalName            String            @db.VarChar(200)
  shortCode            String            @unique @db.VarChar(6)
  type                 InstitutionType
  legalStatus          String            @db.VarChar(200)
  registeredAddress    String            @db.VarChar(500)
  city                 String            @db.VarChar(80)
  state                String            @db.VarChar(80)
  regionId             String            @db.VarChar(32)
  group                String?           @db.VarChar(40)
  jurisdictionCourt    String            @db.VarChar(200)
  arbitrationSeat      String            @db.VarChar(120)
  signatoryName        String            @db.VarChar(120)
  signatoryDesignation String            @db.VarChar(120)
  coordinatorName      String            @db.VarChar(120)
  /// Programme groups offered (rows of a new rate card), in display order.
  programmeGroups      Json
  active               Boolean           @default(true)
  region               Region            @relation(fields: [regionId], references: [id])
  locations            Location[]
  members              UserInstitution[]
  routing              RoutingRule[]
  rateCards            RateCard[]
  templates            TemplateVersion[]
}

/// A campus or office of an institution (agreements are signed for one).
model Location {
  id            String      @id @db.VarChar(40)
  institutionId String      @db.VarChar(32)
  name          String      @db.VarChar(120)
  city          String      @db.VarChar(80)
  sortOrder     Int         @default(0)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, sortOrder])
}

/// Which institutions a staff member works for (their data scope).
model UserInstitution {
  userId        String      @db.VarChar(32)
  institutionId String      @db.VarChar(32)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([userId, institutionId])
  @@index([institutionId])
}

enum RoutingCondition {
  standard
  non_standard
}

/// Who approves an institution's agreements, and who is escalated to when they are late.
model RoutingRule {
  id            String           @id @db.VarChar(32)
  institutionId String           @db.VarChar(32)
  condition     RoutingCondition
  approverId    String           @db.VarChar(32)
  escalateToId  String           @db.VarChar(32)
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, condition])
}

/// App-wide settings: a single row (id = 1).
model Setting {
  id             Int     @id @default(1)
  /// SlaSettings: working days per step, renewal lead times, digest hour.
  sla            Json
  allowedDomains Json
  /// MasterLists: reason lists, document types, stamp states.
  masterLists    Json
  lastDigestDate String? @db.Char(10)
}

enum VersionStatus {
  draft
  pending_approval
  approved
  published
  retired
}

enum ApplyMode {
  new_only
  addendums
}

/// One version of an institution's Annexure-B rates. Published versions are never edited.
model RateCard {
  id                   String        @id @db.VarChar(40)
  institutionId        String        @db.VarChar(32)
  version              Int
  effectiveFrom        String        @db.Char(10)
  status               VersionStatus
  applyMode            ApplyMode
  /// RateRow[]: programme group × admission slab amounts (INR).
  rows                 Json
  /// RateExtra[]: flat extras such as a scholarship bonus.
  extras               Json
  notes                String?       @db.Text
  createdById          String        @db.VarChar(32)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  approvedById         String?       @db.VarChar(32)
  approvedAt           DateTime?     @db.DateTime(3)
  rejectComment        String?       @db.Text
  publishedById        String?       @db.VarChar(32)
  publishedAt          DateTime?     @db.DateTime(3)
  affectedAgreementIds Json?
  institution          Institution   @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, version])
  @@index([institutionId, status])
}

enum CpType {
  individual
  sole_prop
  proprietorship
  partnership
  pvt_ltd
}

/// One version of the agreement template for a CP type (all institutions, or one).
model TemplateVersion {
  id               String        @id @db.VarChar(40)
  institutionId    String?       @db.VarChar(32)
  cpType           CpType
  version          Int
  fileName         String        @db.VarChar(255)
  blobKey          String?       @db.VarChar(255)
  effectiveFrom    String        @db.Char(10)
  status           VersionStatus
  changeNote       String        @db.Text
  uploadedById     String        @db.VarChar(32)
  uploadedAt       DateTime      @default(now()) @db.DateTime(3)
  approvedById     String?       @db.VarChar(32)
  approvedAt       DateTime?     @db.DateTime(3)
  rejectComment    String?       @db.Text
  publishedById    String?       @db.VarChar(32)
  publishedAt      DateTime?     @db.DateTime(3)
  /// TemplateContent: the editable body. Absent on older versions (they render the built-in default).
  content          Json?
  sourceDocumentId String?       @db.VarChar(32)
  institution      Institution?  @relation(fields: [institutionId], references: [id])

  @@index([cpType, institutionId, status])
}
