# Copy to .env (never commit .env). Used by `npm run dev` (Next.js); set the same values in your host for production.

# --- Browser (bundled into the app) ---
# (The older VITE_EMAIL_DELIVERY / VITE_EMAIL_RELAY_URL names still work.)
# Turn real email delivery on. Leave unset to keep the simulated outbox only.
NEXT_PUBLIC_EMAIL_DELIVERY=resend
# Only if the relay is on another origin than the app:
# NEXT_PUBLIC_EMAIL_RELAY_URL=https://your-app.example.com/api/send-email

# --- Server only (never prefix these with NEXT_PUBLIC_) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend. Before verifying one, use onboarding@resend.dev
# (Resend then only delivers to your own Resend account's email address).
EMAIL_FROM=CP Onboarding <onboarding@resend.dev>
# Public address of the app; email links are built from it.
APP_URL=http://localhost:5173
# Testing: deliver every email to this one inbox instead of the real recipient
# (the demo users' addresses are not real). Remove it to email the real recipients.
EMAIL_REDIRECT_TO=you@example.com

# --- Database (server only) ---
# Defaults to the local Docker database from compose.yaml (`npm run db:up`) when unset.
# DATABASE_URL=mysql://cp:cp_local@127.0.0.1:3306/cp_onboarding
